# Copy to .env.local (git-ignored). NEXT_PUBLIC_* values are inlined into the browser bundle at build time;
# everything else is read only on the server.

# Backend base URL (FastAPI) as reachable FROM THE NEXT.JS SERVER.
# Used by server components for direct fetches and by next.config.ts to rewrite browser requests to
# `/api/*` onto the backend. The browser itself never sees this value.
# Default when unset or empty: http://localhost:8000
# NOTE: the rewrite target is fixed at BUILD time — after changing it, rebuild (`npm run build`) or restart `next dev`.
API_BASE_INTERNAL=http://localhost:8000

# Server-only. Must equal the backend's ADMIN_TOKEN when that is set. Attached as X-Admin-Token by server components
# and by the /api/admin|pipeline Route Handler proxy (src/lib/proxy.ts); never shipped to the browser.
# Anyone who can open this frontend can then use the admin screen, so keep the frontend on localhost or behind
# your own access control.
ADMIN_TOKEN=

# 1 = render every page from src/lib/mock.ts without calling the backend; 0 = call the backend
NEXT_PUBLIC_USE_MOCK=0

# Legacy alias of API_BASE_INTERNAL (server-side fallback only). Prefer API_BASE_INTERNAL.
# NEXT_PUBLIC_API_BASE=http://localhost:8000
