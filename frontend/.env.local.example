# Copy to .env.local (git-ignored). NEXT_PUBLIC_* values are inlined at build time.

# Backend base URL (FastAPI). Default when unset: http://localhost:8000
NEXT_PUBLIC_API_BASE=http://localhost:8000

# 1 = render pages from src/lib/mock.ts without calling the backend; 0 = call the backend
NEXT_PUBLIC_USE_MOCK=0
