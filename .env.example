# ---- BigKinds ----
# mock  : fixtures/bigkinds 재생 (예선 기본값, 키 불필요). 시드·정답셋은 fixtures/seeds, fixtures/gold
# record: 실 API 호출 후 응답을 fixtures/bigkinds/recordings 에 저장, 있으면 재생. 시드·정답셋은 seeds/, gold/
# live  : 실 API 직접 호출
BIGKINDS_MODE=mock
BIGKINDS_ACCESS_KEY=
BIGKINDS_BASE_URL=https://tools.kinds.or.kr
BIGKINDS_RPS=2
# record 모드에서 녹화만 재생 (키·네트워크 없이 PT 시연). 녹화에 없는 요청은 실패하고 misses 에 남는다.
BIGKINDS_REPLAY_ONLY=false

# ---- LLM ----
# stub : fixtures/llm/stub_answers.json 재생 (키 불필요). 정답이 없는 항목은 실패로 두고 저장하지 않는다
# live : Anthropic API 호출
LLM_MODE=stub
LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
# 실행당 LLM 호출 상한 (넘으면 나머지는 다음 실행으로)
LLM_MAX_CALLS_PER_RUN=400

# ---- Embedding ----
# st   : sentence-transformers (pip install -e ".[embeddings]" 필요). 모델명이 바뀌면 벡터를 자동 재계산한다
# hash : 문자 n-gram 해싱 (경량, 기본값)
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=jhgan/ko-sroberta-multitask

# ---- Rules (scripts/evaluate.py --sweep 으로 조정) ----
LINK_AUTO=0.55
LINK_REVIEW=0.40
SIGNAL_MIN_CONF=0.6
# 학습 기반 재순위 (docs/EXPERIMENT.md §9) — 게이트를 통과해 자동 연결·검토 큐로 판정된 후보를 분류기 확률로 다시 정한다
# none: 이전 동작(기본) / features: 피처 분류기(backend/models/reranker_features.joblib, pip install -e ".[rerank]")
# cross: 교차 인코더(models/cross_encoder/, scripts/train_cross_encoder.py --save 로 직접 학습) + 피처 분류기를 RERANK_BLEND 비율로 섞음
# 모델을 학습한 임베딩(EMBEDDING_BACKEND=st)과 다르면 쓰지 않는다. 군집은 깨끗해지지만 규칙 후속 신호의 사건 단위 지표는 떨어졌다(§9.4)
LINK_RERANKER=none
RERANK_AUTO=0.5
RERANK_REVIEW=0.2
RERANK_BLEND=0.5
RERANK_KEEP_LATE_FACILITY=true
RERANK_CROSSFIT=true
COMPLETION_MIN_CONF=0.7
STALE_FOLLOWUP_DAYS=60
# 수집 상한: 사건당 총 / 발생 직후 2주 구간(날짜별 배분) / 이후 구간의 조치 상태 질의 월당 상한 / 이후 구간 일반 후속 표본(분기별, 0 이면 생략)
# 이후 구간은 기본 질의 트렌드가 예산 안이면 한 번에 받고(조용한 사건: 사건당 4회), 넘치면 조치 상태 질의(완료·준공·착공 …)로 판정 기사를 직접 찾는다
MAX_ARTICLES_PER_EVENT=300
COLLECT_INITIAL_CAP=150
COLLECT_MONTH_CAP=80
COLLECT_TAIL_SAMPLE=40

# ---- App ----
DATABASE_URL=sqlite:///./data/migyeol.db
# 파이프라인 실행 API(/api/pipeline/run)는 기본 꺼짐. 개발·시연에서만 true
PIPELINE_API_ENABLED=false
# 설정하면 /api/admin/* 와 /api/pipeline/run 에 X-Admin-Token 헤더가 필요하다. 비우면 검사 안 함(로컬 전용)
# 프런트 서버(frontend/.env.local 의 ADMIN_TOKEN)에도 같은 값을 넣어야 관리자 화면이 동작한다 — 브라우저에는 전달되지 않는다
ADMIN_TOKEN=
SCHEDULER_ENABLED=false
# 기준일 고정 (YYYY-MM-DD). 가상 픽스처 시연은 2026-09-11 로 고정. 실데이터(record/live)로 전환할 때는 비우거나
# 녹화한 날짜로 맞춘다 — 과거로 남겨 두면 수집·트렌드 범위가 그 날짜에서 잘린다 (기동 로그·/api/meta 경고)
TODAY_OVERRIDE=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 시드·정답셋 경로를 직접 지정하려면 (비우면 모드로 결정)
SEEDS_FILE=
GOLD_FILE=

# ---- v2 (2026-10-22 멘토 피드백 반영) ----
# LLM_MODE=rules : LLM 키 없이 규칙 어댑터로 약속 추출·후속 신호 분류 (app/llm/rules_adapter.py)
# 실험(§4): 모집단 기간·분류. INCIDENT_PREFIXES 를 비우면 3계열(사고>산업사고, 사고>교통사고, 재해>자연재해)
EXPERIMENT_FROM=2023-01-01
EXPERIMENT_UNTIL=2025-12-31
INCIDENT_PREFIXES=
EXPERIMENT_LATEST_PATH=
# 실험 질의 건수 상한(넘으면 질의를 좁힌다. 넓은 질의는 사건당 100회 넘게 부른다) / 실험 수집 총상한
EXPERIMENT_QUERY_HIT_LIMIT=400
EXPERIMENT_MAX_ARTICLES_PER_EVENT=600
# 공공기관 게시판 확인(§3): 후속보도 부족·판단 불가 사건이 NOTICE_TRIGGER_DAYS 이상 조용할 때만 책임기관 공식 게시판을 읽는다
NOTICE_TRIGGER_DAYS=90
NOTICE_MAX_PAGES=5
NOTICE_REQUEST_INTERVAL_SEC=2
NOTICE_ALLOWED_DOMAINS=.go.kr,.or.kr,korea.kr
NOTICE_MATCH_THRESHOLD=0.5
