# ---- BigKinds ----
# mock  : fixtures/bigkinds 재생 (예선 기본값, 키 불필요)
# record: 실 API 호출 후 응답을 fixtures/bigkinds/recordings 에 저장, 있으면 재생
# live  : 실 API 직접 호출
BIGKINDS_MODE=mock
BIGKINDS_ACCESS_KEY=
BIGKINDS_BASE_URL=https://tools.kinds.or.kr
BIGKINDS_RPS=2

# ---- LLM ----
# stub : fixtures/llm/stub_answers.json 재생 (키 불필요)
# live : Anthropic API 호출
LLM_MODE=stub
LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# ---- Embedding ----
# st   : sentence-transformers (pip install -e ".[embeddings]" 필요)
# hash : 형태소 없는 문자 n-gram 해싱 (경량, 기본값)
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=jhgan/ko-sroberta-multitask

# ---- Rules ----
LINK_AUTO=0.55
LINK_REVIEW=0.40
SIGNAL_MIN_CONF=0.6
COMPLETION_MIN_CONF=0.7
STALE_FOLLOWUP_DAYS=60

# ---- App ----
DATABASE_URL=sqlite:///./data/migyeol.db
PIPELINE_API_ENABLED=true
SCHEDULER_ENABLED=false
TODAY_OVERRIDE=
CORS_ORIGINS=http://localhost:3000
